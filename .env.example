# Copy values from the protected local secrets file (outside git).
# Default path on this machine: %USERPROFILE%\Desktop\services\npe-status\.env
# Override with env var NPE_STATUS_ENV if needed.
#
# Then push secrets to Cloudflare with:
#   powershell -File scripts/sync-secrets.ps1

UPTIME_RELAY_TOKEN=
RESEND_API_KEY=
GITHUB_TOKEN=
RELAY_BASE_URL=https://npe-uptime-relay.example.workers.dev
ALERT_TO=ops@example.com,alerts@example.com
RESEND_FROM=alerts@example.com
RESEND_FROM_NAME=NPE Status
